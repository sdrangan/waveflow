{
  "name": "waveflow-fir-dse-pi",
  "version": "0.1.0",
  "description": "Six bounded FIR design-space tools backed by waveflow's Python service",
  "type": "module",
  "keywords": ["pi-package", "fir", "waveflow"],
  "files": ["index.ts", "skills"],
  "pi": {"extensions": ["./index.ts"], "skills": ["./skills"]},
  "engines": {"node": ">=22.19.0"},
  "peerDependencies": {"@earendil-works/pi-coding-agent": "^0.86.1"},
  "dependencies": {"typebox": "^1.3.27"},
  "devDependencies": {"@types/node": "^22.19.0", "typescript": "^5.9.3", "tsx": "^4.20.0"},
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test.ts",
    "prepare": "node -e \"const fs=require('node:fs'); if(fs.existsSync('../skills/fir-dse')) fs.cpSync('../skills/fir-dse', 'skills/fir-dse', {recursive:true})\"",
    "prepack": "npm run prepare"
  }
}
