# Include top-level documentation
include README.md
include LICENSE

# Include everything in docs/ for GitHub Pages and local builds
recursive-include docs *

# Include example projects (e.g., waveflow)
recursive-include examples *

# Include non-Python files inside the waveflow package
recursive-include waveflow *.json
recursive-include waveflow *.yaml
recursive-include waveflow *.yml
recursive-include waveflow *.txt
recursive-include waveflow *.md
recursive-include waveflow/templates *
recursive-include waveflow/assets *

# Shipped calibration corpus + fixtures (reference platforms, sweep harnesses) — every file type,
# including the distilled corpus.csv the *.json recursion above does not cover.
recursive-include waveflow/calib/platforms *
recursive-include waveflow/calib/fixtures *

# The XSI testbench harness — BFM/loader C++ headers plus the run.bat / run.sh drivers.  These are
# source files that XsiHarnessStep copies into a design's xsi/ workspace at build time, so they must
# be in the wheel: without them a pip-installed user gets "XSI harness source file not found".
recursive-include waveflow/build/xsi *

# Exclude Python cache and build artifacts
global-exclude __pycache__/
global-exclude *.pyc
global-exclude *.pyo