env/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Calibration work dir: sweeps / tests / DAG calib steps write here freely (it churns). Only a tracked
# library (waveflow/calib/platforms/ or a project's calib/platforms/) is committed, and ONLY
# `publish_calib` writes to one. See waveflow/calib/publish.py.
#
# `**/` because a pattern with a mid-string separator is anchored to this file's directory, and a
# project's work tier sits at ITS root — an example under examples/<name>/ is a project, so
# examples/fir_block/calib/work/ has to match too. The `calib/` prefix keeps it specific enough that it
# cannot swallow an unrelated directory called `work/`.
# (The libraries' re-include past the *.json ignore is at the top of this file.)
**/calib/work/

# Distribution artifacts
*.egg-info/
dist/
# Anchored with a leading slash ON PURPOSE: setuptools only ever emits build/ at the repo root.
# Unanchored, `build/` matches any directory named `build` at any depth — it silently swallowed
# tests/build/ (losing test_build.py, never committed) and docs/guide/build/, and forced the
# `!waveflow/build/` negation that used to live at the bottom of this file.
/build/

# IDE/editor settings
.idea/

