examples/_archive/conv2d/data/

# Interleaver DATAFLOW de-risk sandbox (exploratory scratch; C1-C6 variants + generated Vitis
# projects/VCDs. Findings are captured in plans/dataflow_mod.md; regenerate via run_interleaver.py.)
examples/interleaver/sandbox/




experiment/

# (The `!waveflow/build/` and `!**/guide/build/headless_output.txt` negations that used to live here
# are gone: they existed only to undo the unanchored `build/` rules, which are now targeted.)

# XSI simulation build output (xelab): xsim.dir/<top>/xsimk.dll + the work/*.sdb it compiles from.
# Regenerated by every `pytest -m xsi` run, so tracking it churns ~2.3MB per run. These were swept in
# by a `git add -A` during the mem_copy split (ce109d6), not by intent.
examples/*/xsi/xsim.dir/
examples/*/xsi/*.log
examples/*/xsi/*.jou
examples/*/xsi/*.pb
examples/*/xsi/.Xil/

# Waveform dumps from a traced XSI run: *.wdb from xsi_trace_all, *.vcd from a $dumpvars dumper
# top. Regenerated per run and ~1-2MB each (a level-1 dump of mem_copy's top scope is 258 signals
# / 1.0MB; interleaver_canon 363 / 1.7MB), so tracking them churns as hard as xsim.dir.
examples/*/xsi/*.vcd
examples/*/xsi/*.wdb

# Generated XSI test-vector bundles (written at gate time; data is *.bin, ignored above).
examples/*/xsi/vectors/

# state_toy (the add_state XSI gate): csynth project + generated top/headers.  The Python source,
# the hand-written hook, and the generated XSI harness/ports stay tracked.
examples/state_toy/state_accum_proj/
examples/state_toy/gen/
examples/state_toy/include/
examples/state_toy/xsi/vectors/

# fir_block (the block FIR -- add_state's motivating design): csynth project + generated
# top/headers.  The Python source, the two HAND-WRITTEN task bodies (fir_cmd_rx_task.h,
# fir_compute_task.h -- sticky at the example root, copied into include/ by the build), and the
# generated XSI harness/ports stay tracked.
examples/fir_block/fir_block_proj/
examples/fir_block/gen/
examples/fir_block/include/
examples/fir_block/xsi/vectors/

# bram_toy (the memory-beside-the-kernel gate): csynth project + generated top/headers, same
# convention as state_toy and fir_block.  What stays TRACKED is the Python source, the two
# hand-written task bodies in src/, and the generated XSI workspace -- including bram_toy_top.v,
# the wrapper, which is the artifact plans/rtl_module.md S2 exists to produce and therefore the
# one whose diff is worth reading.
examples/bram_toy/bram_toy_proj/
examples/bram_toy/gen/
examples/bram_toy/include/
examples/bram_toy/results/
examples/bram_toy/xsi/vectors/
